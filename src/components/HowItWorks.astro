---
import Highlight from "./Highlight.astro";
import { howItWorks } from "../data/site";
---

<section class="section bg-ink">
  <div class="wrap">
    <h2 class="h2 reveal">
      <Highlight text={howItWorks.headline} highlight={howItWorks.highlight} />
    </h2>

    <ol class="mt-12 grid gap-12 md:mt-16 md:grid-cols-3 md:gap-10">
      {
        howItWorks.steps.map((step, i) => (
          <li class="reveal border-t border-white/15 pt-7" style={`--d:${i * 90}ms`}>
            <span class="step-num font-display text-6xl font-semibold leading-none" aria-hidden="true">
              {i + 1}
            </span>
            <h3 class="mt-6 font-display text-2xl font-semibold tracking-tight">
              <span class="sr-only">Step {i + 1}: </span>{step.title}
            </h3>
            <p class="mt-3 leading-relaxed text-white/70">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <p
      class="reveal mt-14 max-w-3xl border-l-2 border-accent pl-5 font-display text-xl font-medium leading-snug tracking-tight text-accent md:mt-20 md:text-2xl"
    >
      {howItWorks.guarantee}
    </p>
  </div>
</section>

<style>
  .step-num {
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.4);
  }
</style>
