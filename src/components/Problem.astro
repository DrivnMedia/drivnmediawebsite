---
import Highlight from "./Highlight.astro";
import { problem } from "../data/site";
---

<section class="section on-light bg-paper text-ink">
  <div class="wrap">
    <h2 class="h2 reveal max-w-3xl">
      <Highlight text={problem.headline} highlight={problem.highlight} />
    </h2>

    <ol class="mt-12 grid gap-5 md:mt-16 md:grid-cols-3 md:gap-6">
      {
        problem.cards.map((card, i) => (
          <li
            class="reveal rounded-2xl border border-ink/10 bg-white p-7 shadow-[0_1px_0_rgb(11_15_20/0.04),0_24px_48px_-32px_rgb(11_15_20/0.25)] md:p-8"
            style={`--d:${i * 90}ms`}
          >
            <span class="font-display text-sm font-semibold tracking-widest text-ink/60">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-8 font-display text-2xl font-semibold tracking-tight">{card.title}</h3>
            <p class="mt-3 leading-relaxed text-ink/70">{card.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
